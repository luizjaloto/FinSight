# Variáveis usadas pelo docker-compose.yml. Copie para .env (o .env não vai para o Git).

# Obrigatório. Gere um valor aleatório com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Opcional: token gratuito da brapi.dev para cotações de todos os ativos
BRAPI_TOKEN=

# Senha do usuário de demonstração criado por scripts/seed_demo.py.
# Deixe vazia se não for usar a conta de demonstração: em produção, o seed se recusa a rodar sem ela.
DEMO_PASSWORD=
