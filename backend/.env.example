# Copie este arquivo para .env e ajuste os valores.

# MongoDB local, Docker (mongodb://mongo:27017) ou Atlas (mongodb+srv://usuario:senha@cluster/...)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=finsight

# Chave para assinar os tokens JWT – use um texto longo e aleatório (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio-com-32-caracteres
JWT_MINUTES=60

# Endereços do front-end autorizados (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Opcional: token gratuito da brapi.dev para cotações de todos os ativos
BRAPI_TOKEN=

# Senha do usuário de demonstração criado por scripts/seed_demo.py
DEMO_PASSWORD=Demo@2026
